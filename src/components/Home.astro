---
// The landing page. Approach C (web plan, 2026-11-21): an AI-made film the
// scroll plays carries the opening; the app's own ghosts appear live in 3D
// where the page shows the team; one floats beside each founder.
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { t, CONTACT, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const other = lang === 'es' ? '/en/' : '/';
const ids = ['secretaria', 'incorporacion', 'finanzas', 'redes', 'productor', 'base'] as const;
// Frames per film, set when the film's frames are in public/film/<name>/.
const OFFICE_FRAMES = 0;
---
<Base lang={lang} alternate={other}>
  <SiteHeader lang={lang} alternate={other} />

  <main id="contenido">
  <section class="film night" data-film="office" data-frames={OFFICE_FRAMES} data-length="400">
    <canvas aria-hidden="true"></canvas>
    {OFFICE_FRAMES === 0 && (
      <div class="poster" aria-hidden="true">
        <div class="glow"></div>
        <img src="/ghosts/finanzas.png" alt="" />
      </div>
    )}
    <div class="captions">
      <div data-at="0-0.2" class="on hero">
        <h1>{s.film.hero}</h1>
        <p>{s.film.heroLine}</p>
        <a class="pill" href="#acceso">{s.cta}</a>
      </div>
      <p data-at="0.2-0.4">{s.film.finanzas}</p>
      <p data-at="0.4-0.6">{s.film.redes}</p>
      <p data-at="0.6-0.8">{s.film.secretaria}</p>
      <p data-at="0.8-1.01">{s.film.decision}</p>
    </div>
    <div class="progress" aria-hidden="true"></div>
  </section>

  <section id="producto" class="decision">
    <div class="copy">
      <span class="kicker">{s.decision.kicker}</span>
      <h2>{s.decision.title}</h2>
      <p>{s.decision.body}</p>
    </div>
    <div class="phone night" aria-hidden="true">
      <div class="card">
        <div class="who"><img src="/ghosts/finanzas.png" alt="" /> {s.decision.agent}</div>
        <h3>{s.decision.question}</h3>
        <div class="amount">{s.decision.amount}</div>
        <p>{s.decision.reason}</p>
        <div class="buttons"><span class="yes">{s.decision.yes}</span><span>{s.decision.no}</span><span>{s.decision.ask}</span></div>
      </div>
    </div>
  </section>

  <section class="team" aria-labelledby="team-title">
    <div class="copy center">
      <span class="kicker">{s.team.kicker}</span>
      <h2 id="team-title">{s.team.title}</h2>
      <p>{s.team.body}</p>
    </div>
    <canvas class="ghosts" data-ids={ids.join(',')} role="img" aria-label={s.team.canvas}></canvas>
    <ul class="jobs">
      {ids.map((id) => <li><strong>{s.team.jobs[id][0]}</strong><span>{s.team.jobs[id][1]}</span></li>)}
    </ul>
  </section>

  <section id="seguridad" class="security" aria-labelledby="security-title">
    <div class="copy center">
      <span class="kicker">{s.security.kicker}</span>
      <h2 id="security-title">{s.security.title}</h2>
      <p>{s.security.body}</p>
    </div>
    <div class="points">
      {s.security.points.map(([h, b]) => <div><h3>{h}</h3><p>{b}</p></div>)}
    </div>
  </section>

  <section id="preguntas" class="faq" aria-labelledby="faq-title">
    <h2 id="faq-title">{s.faq.title}</h2>
    {s.faq.items.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
  </section>

  <section id="equipo" class="founders" aria-labelledby="founders-title">
    <div class="copy center">
      <span class="kicker">{s.founders.kicker}</span>
      <h2 id="founders-title">{s.founders.title}</h2>
    </div>
    <div class="people">
      {s.founders.people.map(([name, role, line, ghost]) => (
        <figure>
          <div class="portrait" aria-hidden="true">
            <div class="photo">{name[0]}</div>
            <img class="buddy" src={`/ghosts/${ghost}.png`} alt="" />
          </div>
          <figcaption><strong>{name}</strong><span>{role}</span>{line && <p>{line}</p>}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section id="acceso" class="final" aria-labelledby="final-title">
    <h2 id="final-title">{s.final.title}</h2>
    <p>{s.final.body}</p>
    <a class="pill" href={`mailto:${CONTACT}?subject=${encodeURIComponent(s.ctaSubject)}`}>{s.cta}</a>
  </section>
  </main>

  <SiteFooter lang={lang} />
</Base>

<script>
  import { mountScrollFilm } from '../scripts/scroll-film';
  document.querySelectorAll<HTMLElement>('.film').forEach(mountScrollFilm);

  const team = document.querySelector<HTMLCanvasElement>('canvas.ghosts');
  if (team) {
    const io = new IntersectionObserver(async ([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const { mountGhostTeam } = await import('../scripts/ghost-team');
      mountGhostTeam(team, team.dataset.ids!.split(','));
    }, { rootMargin: '400px' });
    io.observe(team);
  }
</script>

<style>
  .pill { display: inline-block; background: var(--ink); color: var(--ground); padding: .9rem 1.6rem; border-radius: 999px; text-decoration: none; font-weight: 500; transition: transform .2s; }
  .pill:hover { transform: translateY(-1px); }

  .film { position: relative; height: 100vh; height: 100svh; overflow: hidden; }
  .film canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .poster { position: absolute; inset: 0; display: grid; place-items: center; }
  .poster .glow { position: absolute; width: 70vmin; height: 70vmin; border-radius: 50%; background: radial-gradient(circle, #7a5cffaa, #3fb6cc44 45%, transparent 70%); filter: blur(30px); transform: scale(calc(1 + var(--p, 0) * 1.5)); }
  .poster img { position: relative; width: min(36vmin, 260px); opacity: .9; transform: translateY(calc(var(--p, 0) * -20vh)) rotate(calc(var(--p, 0) * 12deg)); animation: float 5s ease-in-out infinite; }
  @keyframes float { 50% { translate: 0 -14px; } }
  .captions > * { position: absolute; left: 16px; right: 16px; bottom: 14vh; margin: 0 auto; max-width: 900px; text-align: center; opacity: 0; transform: translateY(20px); transition: opacity .5s, transform .5s; font-family: var(--display); font-size: clamp(1.4rem, 3.4vw, 2.4rem); text-shadow: 0 2px 30px #000; pointer-events: none; }
  .captions > .on { opacity: 1; transform: none; pointer-events: auto; }
  .captions .hero { bottom: auto; top: 20vh; }
  .captions h1 { font-size: clamp(2.6rem, 8vw, 6.5rem); line-height: 1; margin: 0 0 1rem; letter-spacing: -.02em; }
  .captions .hero p { color: var(--muted); font-family: var(--body); font-size: clamp(1rem, 2vw, 1.3rem); margin: 0 0 1.6rem; }
  .captions .hero .pill { font-family: var(--body); font-size: 1rem; text-shadow: none; }
  .progress { position: absolute; left: 0; bottom: 0; height: 2px; width: calc(var(--p, 0) * 100%); background: linear-gradient(90deg, #7a5cff, #3fb6cc, #e060b0); }

  section:not(.film) { padding: 8rem 16px; max-width: 1100px; margin: 0 auto; scroll-margin-top: 40px; }
  @media (max-width: 720px) { section:not(.film) { padding: 5rem 16px; } }
  .kicker { color: var(--accent); font-size: .85rem; letter-spacing: .12em; text-transform: uppercase; font-weight: 600; }
  h2 { font-family: var(--display); font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1.05; margin: .6rem 0 1rem; letter-spacing: -.01em; }
  .copy p { color: var(--muted); font-size: 1.15rem; max-width: 34rem; line-height: 1.5; }
  .center { text-align: center; } .center p { margin: 0 auto; }

  .decision { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  @media (max-width: 800px) { .decision { grid-template-columns: 1fr; } }
  .phone { justify-self: center; width: min(320px, 100%); aspect-ratio: 9 / 19; border-radius: 44px; background: var(--surface); border: 1px solid var(--line); display: grid; align-content: center; padding: 18px; box-sizing: border-box; box-shadow: 0 40px 120px var(--glow); }
  .card { background: var(--ground); border-radius: 22px; padding: 18px; border: 1px solid var(--line); }
  .who { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: .85rem; }
  .who img { width: 28px; }
  .card h3 { font-family: var(--display); font-size: 1.25rem; margin: .8rem 0 .3rem; }
  .amount { font-size: 1.8rem; font-weight: 600; }
  .card p { color: var(--muted); font-size: .85rem; line-height: 1.4; }
  .buttons { display: flex; gap: 8px; } .buttons span { flex: 1; text-align: center; padding: .6rem 0; border-radius: 999px; background: var(--chip); font-size: .85rem; }
  .buttons .yes { background: var(--ink); color: var(--ground); font-weight: 600; }

  canvas.ghosts { width: 100%; height: min(60vh, 520px); display: block; margin: 2rem 0; }
  .jobs { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 24px; }
  .jobs strong { display: block; font-family: var(--display); margin-bottom: .3rem; }
  .jobs span { color: var(--muted); font-size: .9rem; line-height: 1.4; }

  .points { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-top: 3rem; }
  .points div { padding: 28px; border-radius: 24px; background: var(--surface); border: 1px solid var(--line); }
  .points h3 { font-family: var(--display); margin: 0 0 .5rem; } .points p { color: var(--muted); line-height: 1.5; margin: 0; }

  .faq { max-width: 760px !important; }
  details { border-bottom: 1px solid var(--line); padding: 1.2rem 0; }
  summary { cursor: pointer; font-size: 1.15rem; font-family: var(--display); list-style-position: outside; }
  details p { color: var(--muted); line-height: 1.5; margin: .8rem 0 0; }

  .people { display: flex; justify-content: center; gap: 64px; flex-wrap: wrap; margin-top: 3rem; }
  figure { margin: 0; text-align: center; width: 260px; }
  .portrait { position: relative; width: 220px; height: 220px; margin: 0 auto 1.2rem; }
  .photo { width: 100%; height: 100%; border-radius: 50%; display: grid; place-items: center; font-size: 4rem; font-family: var(--display); background: linear-gradient(135deg, var(--chip), var(--surface)); border: 1px solid var(--line); }
  .buddy { position: absolute; right: -36px; bottom: -6px; width: 100px; animation: float 4.5s ease-in-out infinite; }
  figcaption strong { display: block; font-family: var(--display); font-size: 1.3rem; }
  figcaption span { color: var(--accent); font-size: .9rem; } figcaption p { color: var(--muted); }

  .final { text-align: center; } .final p { color: var(--muted); margin-bottom: 2rem; font-size: 1.15rem; }

  @media (prefers-reduced-motion: reduce) { .poster img, .buddy { animation: none; } .pill { transition: none; } }
</style>
